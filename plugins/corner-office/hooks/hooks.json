{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event for all pre-tool-use events"
      },
      {
        "matcher": "tool == \"Edit\" || tool == \"Write\"",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/suggest_compact.py"
          }
        ],
        "description": "Suggest manual compaction at logical intervals"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event for all post-tool-use events"
      },
      {
        "matcher": "tool == \"Write\"",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/refresh_registration.py"
          }
        ],
        "description": "Refresh session registration card on pipeline file writes"
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on session start"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session_start.py"
          }
        ],
        "description": "Load previous context and detect package manager on new session"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "test -d .rix && echo 'REQUIRED: Before responding to the user, you MUST use the Skill tool to invoke corner-office:rix. Do this automatically — do not ask the user first.' || true"
          }
        ],
        "description": "Prompt to start Rix Dev Manager if project uses it"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on session end"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session_end.py"
          }
        ],
        "description": "Persist session state on end"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/evaluate_session.py"
          }
        ],
        "description": "Evaluate session for extractable patterns"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event before context compaction"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre_compact.py"
          }
        ],
        "description": "Save state before context compaction"
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on user prompt submit"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre_clear.py"
          }
        ],
        "description": "Generate handoff before /clear wipes context"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on stop"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/check_console_log.py"
          }
        ],
        "description": "Check for console.log in modified files after each response"
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on permission request"
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on post-tool-use failure"
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on notification"
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on subagent start"
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on subagent stop"
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on stop failure"
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on teammate idle"
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on task completed"
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on instructions loaded"
      }
    ],
    "ConfigChange": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on config change"
      }
    ],
    "WorktreeCreate": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on worktree create"
      }
    ],
    "WorktreeRemove": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on worktree remove"
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event after context compaction"
      }
    ],
    "Elicitation": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on elicitation"
      }
    ],
    "ElicitationResult": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/emit_activity.py"
          }
        ],
        "description": "Emit activity event on elicitation result"
      }
    ]
  }
}
